{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Prometheus","type":"datasource","pluginId":"prometheus"}],
  "__requires": [
    {"type":"grafana","id":"grafana","name":"Grafana","version":"11.0.0"},
    {"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"}
  ],
  "uid": "mainframe-adapter-utilization",
  "title": "Mainframe — adapter utilization",
  "description": "Per-adapter utilization. DPM: adapter metric group. Classic: crypto-usage, flash-memory-usage, roce-usage (HMC >= 2.12.0). Entity: mainframe.adapter.",
  "tags": ["mainframe","semconv","mainframe"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from":"now-1h","to":"now"},
  "panels": [
    {
      "id": 1,
      "title": "Fraction of time the adapter was busy processing I/O or requests",
      "description": "Metric: mainframe.adapter.utilization. Unit: 1 (ratio 0-1). DPM + classic mode. Distinguish adapter types with mainframe.adapter.type label.",
      "type": "gauge",
      "gridPos": {"x":0,"y":0,"w":24,"h":10},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"expr":"mainframe_adapter_utilization{job=~\".+\"}","legendFormat":"{{mainframe_adapter_name}} ({{mainframe_adapter_type}})"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","min":0,"max":1,"custom":{}}}
    },
    {
      "id": 2,
      "title": "Fraction of time the adapter was busy — crypto adapters",
      "description": "Metric: mainframe.adapter.utilization{mainframe_adapter_type=\"crypto\"}. Classic mode, HMC >= 2.12.0.",
      "type": "gauge",
      "gridPos": {"x":0,"y":10,"w":8,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"expr":"mainframe_adapter_utilization{mainframe_adapter_type=\"crypto\",job=~\".+\"}","legendFormat":"{{mainframe_adapter_name}}"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","min":0,"max":1,"custom":{}}}
    },
    {
      "id": 3,
      "title": "Fraction of time the adapter was busy — Flash Express adapters",
      "description": "Metric: mainframe.adapter.utilization{mainframe_adapter_type=\"flash\"}. Classic mode, HMC >= 2.12.0.",
      "type": "gauge",
      "gridPos": {"x":8,"y":10,"w":8,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"expr":"mainframe_adapter_utilization{mainframe_adapter_type=\"flash\",job=~\".+\"}","legendFormat":"{{mainframe_adapter_name}}"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","min":0,"max":1,"custom":{}}}
    },
    {
      "id": 4,
      "title": "Fraction of time the adapter was busy — RoCE adapters",
      "description": "Metric: mainframe.adapter.utilization{mainframe_adapter_type=\"roce\"}. Classic mode, HMC >= 2.12.1.",
      "type": "gauge",
      "gridPos": {"x":16,"y":10,"w":8,"h":8},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [{"expr":"mainframe_adapter_utilization{mainframe_adapter_type=\"roce\",job=~\".+\"}","legendFormat":"{{mainframe_adapter_name}}"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","min":0,"max":1,"custom":{}}}
    }
  ]
}
