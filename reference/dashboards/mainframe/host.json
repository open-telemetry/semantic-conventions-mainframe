{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "mainframe-host",
  "title": "Mainframe \u2014 mainframe host",
  "description": "Auto-generated from mainframe semantic conventions. Entity: mainframe.host.",
  "tags": [
    "mainframe",
    "semconv",
    "mainframe"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Number of active processors of the specified type installed in the mainframe system",
      "description": "Metric: mainframe.host.cpu.active.count. Unit: {cpu}.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_host_cpu_active_count{job=~\".+\"}",
          "legendFormat": "{{mainframe_cpu_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        }
      }
    },
    {
      "id": 2,
      "title": "Number of defective processors in the mainframe system",
      "description": "Metric: mainframe.host.cpu.defective.count. Unit: {cpu}.",
