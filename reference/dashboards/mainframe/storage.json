{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "mainframe-storage",
  "title": "Mainframe \u2014 storage",
  "description": "DPM storage group and volume metrics (HMC >= 2.14.1). Entities: mainframe.storage.group, mainframe.storage.group.volume, mainframe.adapter.",
  "tags": [
    "mainframe",
    "semconv",
    "mainframe"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Fulfillment state of the DPM storage group as a numeric code",
      "description": "Metric: mainframe.storage.group.status.code. Unit: 1. 0=complete, 1=pending, 2=pending-with-mismatches, 3=checking-migration, 4=incomplete.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_status_code{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "complete",
                  "color": "green"
                },
                "1": {
                  "text": "pending",
                  "color": "yellow"
                },
                "4": {
                  "text": "incomplete",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {}
        }
      }
    },
    {
      "id": 2,
      "title": "Indicates whether the DPM storage group is shared across multiple partitions",
      "description": "Metric: mainframe.storage.group.shared. Unit: 1 (0=dedicated, 1=shared).",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_shared{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "dedicated"
                },
                "1": {
                  "text": "shared"
                }
              }
            }
          ],
          "custom": {}
        }
      }
    },
    {
      "id": 3,
      "title": "Maximum number of DPM partitions the FCP storage group can be simultaneously attached to",
      "description": "Metric: mainframe.storage.group.max.partitions. Unit: {partition}. FCP-type only.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_max_partitions{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        }
      }
    },
    {
      "id": 4,
      "title": "Fulfillment state of the DPM storage volume as a numeric code",
      "description": "Metric: mainframe.storage.group.volume.status.code. Unit: 1. 0=complete, 5=pending, 3=incomplete, etc.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_volume_status_code{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}/{{mainframe_storage_group_volume_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "complete",
                  "color": "green"
                },
                "5": {
                  "text": "pending",
                  "color": "yellow"
                },
                "3": {
                  "text": "incomplete",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {}
        }
      }
    },
    {
      "id": 5,
      "title": "Size of the DPM storage volume in gibibytes",
      "description": "Metric: mainframe.storage.group.volume.size. Unit: GiBy.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_volume_size{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}/{{mainframe_storage_group_volume_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gibibytes",
          "custom": {}
        }
      }
    },
    {
      "id": 6,
      "title": "Size of the DPM ECKD storage volume in cylinders",
      "description": "Metric: mainframe.storage.group.volume.cylinders. Unit: {cylinder}. FC-type volumes only.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_storage_group_volume_cylinders{job=~\".+\"}",
          "legendFormat": "{{mainframe_storage_group_name}}/{{mainframe_storage_group_volume_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        }
      }
    },
    {
      "id": 7,
      "title": "Operational status of the mainframe I/O adapter as a numeric code",
      "description": "Metric: mainframe.adapter.status.code. Unit: 1. 0=active, 1=not-active, 2=not-detected, 3=exceptions, 4=service.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_adapter_status_code{job=~\".+\"}",
          "legendFormat": "{{mainframe_adapter_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "active",
                  "color": "green"
                },
                "1": {
                  "text": "not-active",
                  "color": "yellow"
                },
                "3": {
                  "text": "exceptions",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {}
        }
      }
    },
    {
      "id": 8,
      "title": "Physical channel status of the mainframe I/O adapter as a numeric code",
      "description": "Metric: mainframe.adapter.physical_channel.status.code. Unit: 1. 0=operating, 9=permanent-error, etc.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "mainframe_adapter_physical_channel_status_code{job=~\".+\"}",
          "legendFormat": "{{mainframe_adapter_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "operating",
                  "color": "green"
                },
                "9": {
                  "text": "permanent-error",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {}
        }
      }
    }
  ]
}
