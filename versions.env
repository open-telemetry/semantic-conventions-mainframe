# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.25.0

# renovate: datasource=github-tags depName=open-telemetry/semantic-conventions versioning=semver-coerced
SEMCONV_VERSION=v1.42.0

# renovate: datasource=git-refs depName=open-telemetry/opentelemetry-weaver-packages versioning=git ref=main
POLICY_REPO_URL=https://github.com/open-telemetry/opentelemetry-weaver-packages.git
POLICY_REPO_REF=78a451d4d4bfdb2956233af300ffbc55c5249fa2

# Shared weaver-packages template commit used for docs generation.
# Pinned to the same ref as the policy repo so a single bump keeps everything in sync.
WEAVER_PACKAGES_REF=$(POLICY_REPO_REF)

# --- Reference observability stack image versions ---
# renovate: datasource=github-releases depName=open-telemetry/opentelemetry-collector-releases versioning=semver-coerced
OTELCOL_VERSION=0.157.0

# renovate: datasource=github-releases depName=prometheus/prometheus versioning=semver-coerced
PROMETHEUS_VERSION=v3.13.1

# renovate: datasource=github-releases depName=grafana/grafana versioning=semver-coerced
GRAFANA_VERSION=11.6.16
